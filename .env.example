# DeepSeek-API Configuration Template
# Copy this file to .env:  cp .env.example .env

# Server binding
HOST=127.0.0.1
PORT=8010

# Optional API Key: when set, all /v1/* requests require `Authorization: Bearer <key>`
# API_KEY=sk-your-secret-api-key

# Rate limiting (requests per minute per client IP, default 30)
# RATE_LIMIT_PER_MINUTE=30

# Reverse proxy / trusted proxies for accurate IP rate limiting
# TRUST_PROXY_HEADERS=1
# TRUSTED_PROXIES=127.0.0.1,::1

# Upstream proxy for outbound requests to DeepSeek (residential SOCKS5/HTTP proxy)
# UPSTREAM_PROXY=socks5://127.0.0.1:1080
# Or: UPSTREAM_PROXY=http://user:password@residential-proxy.example.com:8010

# Stealth / Human simulation mode: adds randomized reading/thinking delays between turns
# STEALTH_MODE=0
# STEALTH_MIN_DELAY=2.0
# STEALTH_MAX_DELAY=6.0

# PoW timing simulation: injects realistic V8 event loop computation delay (120ms-320ms)
# SIMULATE_POW_LATENCY=1

# AWS WAF token refresh sidecar (rotates aws-waf-token headlessly in the background)
# ENABLE_WAF_SIDECAR=1
# WAF_REFRESH_INTERVAL=2400

# CORS origins (comma-separated). Empty = disabled, * = allow all (use carefully)
# CORS_ORIGINS=http://localhost:3000

# Model aliases: map frontend model names to real DeepSeek models
# MODEL_ALIASES=deepseek-v4-pro=deepseek-chat,gpt-4o=deepseek-chat

# Chrome profile directory (default: session/profile)
# DEEPSEEK_PROFILE_DIR=session/profile

# Headless / Interactive login behavior:
# 1 (default) = open visible browser if session missing
# 0 = return 503 if session missing
# SERVER_INTERACTIVE_LOGIN=1

# Automatic sign-in. When DeepSeek rejects the token ("Authorization Failed
# (invalid token)") the server opens a browser window, fills in the last
# account's email and password, waits for the session (solve a human-check in
# the window if one appears) and retries the request. Credentials come from
# these variables, or else from the sign-up automation's .env, which always
# points at the newest registered account.
# DEEPSEEK_EMAIL=you@example.com
# DEEPSEEK_PASSWORD=...
# ACCOUNT_ENV_FILE=/home/you/Desktop/Create account deepseek/.env
# LOGIN_TIMEOUT=300

# Registering a fresh account through the Chrome extension (extension/README.md).
# The server reads the verification code from Gmail; the app password comes
# from the sign-up automation's .env (ACCOUNT_ENV_FILE) or from here.
# GMAIL_EMAIL=you@gmail.com
# GMAIL_APP_PASSWORD=...
# Shared secret the extension must send as X-Register-Token (optional; the
# /register routes already answer only direct requests from this machine).
# REGISTER_TOKEN=
# When DeepSeek mutes the account: "extension" (default) registers a fresh one
# through the Chrome extension without going down, starting Chrome if it is
# not open (CHROME_BINARY / CHROME_PROFILE_DIRECTORY pick which), and falls
# back to "restart" if that fails; "restart" exits straight away so bin/start
# can run the sign-up automation.
# MUTED_RECOVERY=extension
# CHROME_BINARY=/usr/bin/google-chrome-stable
# CHROME_PROFILE_DIRECTORY=Default

# HTTPS. ./setup-https.sh gets a Let's Encrypt certificate and fills these in.
# With HOST=0.0.0.0 the port then serves HTTPS to the network and stays plain
# HTTP on 127.0.0.1 for this machine's tools (extension, register, tunnel);
# LOCAL_HTTP=0 makes it HTTPS everywhere. A renewed certificate is reloaded
# without a restart.
# SSL_CERTFILE=/home/you/deepseek-certs/fullchain.pem
# SSL_KEYFILE=/home/you/deepseek-certs/privkey.pem
# LOCAL_HTTP=1
