{
  "manifest_version": 3,
  "name": "DeepSeek Register",
  "version": "1.0.0",
  "description": "Creates a fresh DeepSeek account when the local Deepseek-API server asks for one, and hands it the session.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "tabs", "scripting", "cookies", "browsingData"],
  "optional_permissions": ["debugger"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://127.0.0.1:*/*",
    "https://localhost:*/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "DeepSeek Register" },
  "incognito": "spanning"
}
